{
  "name": "frost",
  "productName": "Frost",
  "version": "0.2.0",
  "description": "Fully customizable acrylic terminal for Windows with agent mode",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "shots": "electron tools/shots.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test:status": "electron tools/statustest.js"
  },
  "license": "MIT",
  "author": "azekyoo",
  "repository": {
    "type": "git",
    "url": "https://github.com/azekyoo/frost.git"
  },
  "type": "commonjs",
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.17.0-beta.291",
    "@xterm/addon-unicode11": "^0.10.0-beta.290",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.azekyoo.frost",
    "productName": "Frost",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "assets/icon-*.png",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@lydell/**"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Frost",
      "uninstallDisplayName": "Frost",
      "include": "build/installer.nsh",
      "artifactName": "Frost-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Frost-${version}-portable.exe"
    }
  }
}
